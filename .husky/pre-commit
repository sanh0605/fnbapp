#!/usr/bin/env sh
# Pre-commit gate per CLAUDE.md section 9 (Xong việc nghĩa là gì).
# Claude code — enforce TS check that Next.js SWC may mask.

echo "[pre-commit] Running tsc --noEmit..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "[pre-commit] FAIL: TypeScript errors. Fix before commit."
  echo "[pre-commit] Tip: nếu bị block bởi TS6053 missing files, verify file path tồn tại."
  exit 1
fi

echo "[pre-commit] PASS: tsc clean."

echo "[pre-commit] Running rule drift check..."
npx vite-node scripts/check-rules-current.ts
if [ $? -ne 0 ]; then
  echo "[pre-commit] FAIL: a rule document disagrees with the repository."
  echo "[pre-commit] Sua quy tac cho dung thuc te, dung sua checker cho im lang."
  exit 1
fi

echo "[pre-commit] PASS: rules current."

echo "[pre-commit] Running documentation gates..."
npx vite-node scripts/doc-checks/run-blocking.ts
if [ $? -ne 0 ]; then
  echo "[pre-commit] FAIL: a document disagrees with the code. Fix the doc, or add a reviewed-no-change line."
  exit 1
fi
echo "[pre-commit] PASS: docs current."
